{
  "expo": {
    "name": "Proselector",
    "slug": "gi_lyd_selektor",
    "scheme": "pro-selektor",
    "version": "2.6.3",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSBonjourServices": [
          "_ssh._tcp",
          "_http._tcp"
        ],
        "NSLocalNetworkUsageDescription": "This app needs access to the local network to detect devices.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Your app needs microphone access for audio streaming.",
        "NSCameraUsageDescription": "This app needs camera access"
      },
      "bundleIdentifier": "io.cringemaster4k.gi-lyd-selektor",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "versionCode": 31,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "WAKE_LOCK",
        "ACCESS_FINE_LOCATION",
        "NEARBY_WIFI_DEVICES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.GiLyd.gi_lyd_selektor"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidLocalSigning",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cb3643cd-8ada-416f-be58-664579850306"
      }
    },
    "owner": "cringemaster4k"
  }
}
